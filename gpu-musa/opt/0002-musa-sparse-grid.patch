+size_t grid_offset(size_t type) {
+    return grids_header_bytes + type * sizeof(grid_cl);
+}
+
+bool stage_grid_header(GridHeaders& headers, size_t offset, size_t bytes, const void* src) {
+    if (offset == 0 && bytes == grids_header_bytes && !headers.have_common) {
+        std::memcpy(headers.common.data(), src, bytes);
+        headers.have_common = true;
+        return true;
+    }
+    if (offset < grids_header_bytes || bytes != grid_header_bytes) return false;
+    const size_t type = (offset - grids_header_bytes) / sizeof(grid_cl);
+    if (type >= GRIDS_SIZE || offset != grid_offset(type) || headers.have_grid[type]) return false;
+    std::memcpy(headers.grid[type].data(), src, bytes);
+    headers.have_grid[type] = true;
+    return true;
+}
+
+template<class Copy>
+bool copy_grid_headers(const GridHeaders& headers, Copy copy) {
+    if (headers.have_common && !copy(0, headers.common.size(), headers.common.data())) return false;
+    for (size_t type = 0; type < GRIDS_SIZE; ++type) {
+        if (headers.have_grid[type] &&
+            !copy(grid_offset(type), headers.grid[type].size(), headers.grid[type].data())) return false;
+    }
+    return true;
+}
+
+void free_sparse_grid(SparseGrid& sparse, const VmmApi& api) {
+    for (size_t i = 0; i < sparse.count; ++i) {
+        const auto& range = sparse.ranges[i];
+        if (range.mapped && api.unmap(sparse.base + range.begin, range.end - range.begin) != MUSA_SUCCESS)
+            checkErr(CL_OUT_OF_RESOURCES);
+        if (range.created && api.release(range.handle) != MUSA_SUCCESS)
+            checkErr(CL_OUT_OF_RESOURCES);
+    }
+    if (api.free_address(sparse.base, sparse.reserved_bytes) != MUSA_SUCCESS)
+        checkErr(CL_OUT_OF_RESOURCES);
+}
+
+bool populate_sparse_grid(cl_mem h, SparseGrid& sparse, const VmmApi& api,
+                          const MUmemAllocationProp& allocation, const MUmemAccessDesc& access) {
+    for (size_t i = 0; i < sparse.count; ++i) {
+        auto& range = sparse.ranges[i];
+        const size_t bytes = range.end - range.begin;
+        if (api.create(&range.handle, bytes, &allocation, 0) != MUSA_SUCCESS) return false;
+        range.created = true;
+        if (api.map(sparse.base + range.begin, bytes, 0, range.handle, 0) != MUSA_SUCCESS) return false;
+        range.mapped = true;
+        if (api.access(sparse.base + range.begin, bytes, &access, 1) != MUSA_SUCCESS) return false;
+    }
+    const bool copied = copy_grid_headers(*h->headers, [&](size_t offset, size_t bytes, const char* src) {
+        return api.copy(sparse.base + offset, src, bytes) == MUSA_SUCCESS;
+    });
+    // Complete host-to-device DMA before launching or unmapping on fallback.
+    checked(musaStreamSynchronize(nullptr));
+    return copied;
+}
+
+bool use_sparse_grid(cl_mem h, int atom_type, int atom_types) {
+    const GridHeaders& headers = *h->headers;
+    if (!headers.have_common || !std::all_of(headers.have_grid.begin(), headers.have_grid.end(),
+                                             [](bool have) { return have; })) return false;
+
+    int header_atom_type;
+    std::memcpy(&header_atom_type, headers.common.data() + offsetof(grids_cl, atu), sizeof(int));
+    if (atom_types != GRIDS_SIZE || atom_type != header_atom_type) return false;
+
+    std::array<int, 3> dims;
+    std::memcpy(dims.data(), headers.grid[0].data() + offsetof(grid_cl, m_i), 3 * sizeof(int));
+    const int limits[]{MAX_NUM_OF_GRID_MI, MAX_NUM_OF_GRID_MJ, MAX_NUM_OF_GRID_MK};
+    for (size_t axis = 0; axis < dims.size(); ++axis) {
+        if (dims[axis] < 2 || dims[axis] > limits[axis]) return false;
+    }
+    for (const auto& header : headers.grid) {
+        if (std::memcmp(header.data() + offsetof(grid_cl, m_i), dims.data(), 3 * sizeof(int)) != 0)
+            return false;
+    }
+
+    const auto& api = vmm_api();
+    if (!api.available) return false;
+
+    MUmemAllocationProp allocation{};
+    allocation.type = MU_MEM_ALLOCATION_TYPE_PINNED;
+    allocation.location.type = MU_MEM_LOCATION_TYPE_DEVICE;
+    allocation.location.id = 0; // SetupDevice exposes exactly one device.
+    MUmemAccessDesc access{};
+    access.location = allocation.location;
+    access.flags = MU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+
+    size_t page;
+    if (api.granularity(&page, &allocation, MU_MEM_ALLOC_GRANULARITY_MINIMUM) != MUSA_SUCCESS ||
+        page == 0 || page > h->bytes || (page & (page - 1)) != 0) return false;
+    const auto align_up = [page](size_t bytes) { return (bytes + page - 1) & ~(page - 1); };
+
+    auto sparse = std::make_unique<SparseGrid>();
+    sparse->reserved_bytes = align_up(h->bytes);
+    const size_t grid_bytes = static_cast<size_t>(dims[0]) * dims[1] * dims[2] * 8 * sizeof(float);
+    for (size_t type = 0; type < GRIDS_SIZE; ++type) {
+        // Kernel1 writes the entire point prefix, including boundary points.
+        const size_t begin = grid_offset(type) & ~(page - 1);
+        const size_t end = align_up(grid_offset(type) + grid_header_bytes + grid_bytes);
+        if (sparse->count && begin <= sparse->ranges[sparse->count - 1].end) {
+            sparse->ranges[sparse->count - 1].end = end;
+        } else {
+            sparse->ranges[sparse->count++] = {begin, end};
+        }
+    }
+    size_t mapped_bytes = 0;
+    for (size_t i = 0; i < sparse->count; ++i) {
+        const auto& range = sparse->ranges[i];
+        mapped_bytes += range.end - range.begin;
+    }
+    if (mapped_bytes >= h->bytes) return false;
+    if (api.reserve(&sparse->base, sparse->reserved_bytes, page, 0, 0) != MUSA_SUCCESS) return false;
+    if (!populate_sparse_grid(h, *sparse, api, allocation, access)) {
+        free_sparse_grid(*sparse, api);
+        return false;
+    }
+
+    h->ptr = reinterpret_cast<void*>(sparse->base);
+    h->sparse = std::move(sparse);
+    h->headers.reset();
+    record_allocation(h, mapped_bytes);
+    if (profile) std::fprintf(profile, "grid_vmm_mapped_bytes %zu\n", mapped_bytes);
+    return true;
+}
+
+bool usable_range(cl_mem h, size_t offset, size_t bytes) {
+    if (!h->sparse) return true;
+    const auto& grid = *h->sparse;
+    return std::any_of(grid.ranges.begin(), grid.ranges.begin() + grid.count,
+                       [&](const MappedRange& range) { return range.begin <= offset && offset + bytes <= range.end; });
+}
